{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "files": {
    "includes": ["src/**/*.ts", "tests/**/*.ts"]
  },
  "overrides": [
    {
      "includes": ["**/*.{test,spec}.{ts,tsx,js,jsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConditionalExpect": "off"
          }
        }
      }
    }
  ]
}
