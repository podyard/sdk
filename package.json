{
  "name": "@podyard/sdk",
  "version": "0.2.0",
  "description": "Podyard SDK - great DX client for Podyard sandboxes",
  "keywords": [
    "podyard",
    "sandbox",
    "sdk",
    "client",
    "typescript",
    "exec",
    "snapshots",
    "templates"
  ],
  "homepage": "https://github.com/podyard/sdk#readme",
  "bugs": {
    "url": "https://github.com/podyard/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/podyard/sdk.git"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "clean": "git clean -xdf dist .turbo node_modules",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frontal-labs/error": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "^8.2.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
